{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc",
    "import",
    "jsx-a11y",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css",
          "@fontsource/**",
          "@fontsource-variable/**",
          "fake-indexeddb/auto",
          "@testing-library/jest-dom/vitest"
        ]
      }
    ],
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expect*"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    ".output",
    ".tanstack",
    ".claude",
    "src/routeTree.gen.ts",
    "playwright-report",
    "test-results"
  ],
  "overrides": [
    {
      "files": [
        "src/sw.js"
      ],
      "env": {
        "browser": false,
        "serviceworker": true
      }
    },
    {
      "files": [
        "src/lib/openapi/openapi.worker.ts",
        "src/lib/openapi/worker-client.ts",
        "src/lib/persistence.ts"
      ],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": [
        "src/lib/storage/repository.ts",
        "src/lib/storage/repository.test.ts"
      ],
      "rules": {
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": [
        "src/components/route-editor/*-panel.tsx",
        "src/components/route-editor/row-parts.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}
