{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "openapi-editor",
  "version": "0.1.0",
  "identifier": "dev.openapi.editor",
  "mainBinaryName": "openapi-editor",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenAPI Editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "OpenAPI WYSIWYG Editor",
    "longDescription": "A visual, offline-first OpenAPI specification editor with multi-file workspace support.",
    "category": "DeveloperTool",
    "copyright": "Copyright 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
